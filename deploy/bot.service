[Unit]
Description=Feishu/Lark bot (WebSocket long connection)
Documentation=https://github.com/123123213weqw/bots
# Restarting too eagerly hammers the platform and can trip its rate limits.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/bots
ExecStart=/bin/sh -c 'exec "$(command -v node)" dist/index.js'
Environment=NODE_ENV=production
Environment=BOT_REPLY_MODE=reply
Restart=always
RestartSec=5

# Credentials live in .env (mode 600), read by the process, never in the unit.
# Keep the service from writing anywhere it does not need.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/bots

[Install]
WantedBy=default.target

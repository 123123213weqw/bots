[Unit]
Description=Run the AI-inference digest every six hours
Documentation=https://github.com/123123213weqw/bots

[Timer]
# 00:00, 06:00, 12:00, 18:00 in the system timezone (host is CST, UTC+8).
# The service pins TZ too, so the date printed in the message matches what the
# reader sees regardless of how systemd was started.
OnCalendar=*-*-* 00,06,12,18:00:00
# A machine that was off for a slot runs once on boot rather than skipping it.
Persistent=true
# Spread the four daily runs so they do not all land on the same second as other
# timers on this box.
RandomDelaySec=900
Unit=digest.service

[Install]
WantedBy=timers.target

{
  "name": "bots",
  "version": "0.2.0",
  "description": "Feishu/Lark bot over a WebSocket long connection, with an outbound media pipeline",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts",

    "start:dist": "node dist/index.js",
    "test": "node --test \"tests/*.test.ts\"",
    "send": "node src/cli.ts",
    "doctor": "node src/doctor.ts"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.76.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}

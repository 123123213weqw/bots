# Feishu / Lark self-built app credentials
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=replace_with_your_secret

# DeepSeek (OpenAI-compatible). Leave the key empty to run in echo mode.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=800

# Optional
# BOT_SYSTEM_PROMPT=
# BOT_REPLY_MODE=reply
